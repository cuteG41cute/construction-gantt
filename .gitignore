# ============================================================
#  .gitignore —— 防止本地数据/构建产物被误传到远程仓库
# ============================================================

# ---- 程序数据（最重要！这里存的是真实排期，绝不能传）----
autosave.json
autosave_backup_*.json
cache_*.json

# ---- 版本快照（会包含上面那些数据）----
版本快照/

# ---- 打包产物 ----
_internal/
_dist/
_build/
*.spec
*.exe
*.exe.bak

# ---- 打包/版本管理脚本里的本机路径留痕（可选保留，见 README）----
# 若你不想公开这些辅助脚本，取消下面注释
# 重新打包.py
# 重新打包.bat
# 版本管理.py
# 版本管理.bat

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*~
*.swp

# ---- 临时文件 ----
*.tmp
*.log
_update_readme.py
